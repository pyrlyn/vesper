# Locks, condition variables and threads for the PTY workers, on every target. In C rather than
# Kotlin because the timed wait must run on a monotonic clock, which each system spells differently
# (a condattr clock on Linux, a relative wait on macOS, a millisecond timeout on Windows).
package = scull.pty.sys
---
/* ptsname_r and pthread_setname_np are GNU extensions in glibc. */
#if defined(__linux__) && !defined(_GNU_SOURCE)
#define _GNU_SOURCE
#endif
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#ifdef _WIN32
#include <windows.h>
#else
#include <errno.h>
#include <pthread.h>
#include <time.h>
#endif

#ifdef _WIN32
typedef struct {
    SRWLOCK lock;
    int32_t count;
    CONDITION_VARIABLE* conds;
} scull_monitor_impl;
#else
typedef struct {
    pthread_mutex_t lock;
    int32_t count;
    pthread_cond_t* conds;
} scull_monitor_impl;
#endif

/* A mutex with `conds` condition variables, or NULL when memory or the system runs out. */
static void* scull_monitor_new(int32_t conds) {
    if (conds < 1) return NULL;
    scull_monitor_impl* m = (scull_monitor_impl*)calloc(1, sizeof(scull_monitor_impl));
    if (m == NULL) return NULL;
#ifdef _WIN32
    m->conds = (CONDITION_VARIABLE*)calloc((size_t)conds, sizeof(CONDITION_VARIABLE));
    if (m->conds == NULL) { free(m); return NULL; }
    InitializeSRWLock(&m->lock);
    for (int32_t i = 0; i < conds; i++) InitializeConditionVariable(&m->conds[i]);
#else
    m->conds = (pthread_cond_t*)calloc((size_t)conds, sizeof(pthread_cond_t));
    if (m->conds == NULL) { free(m); return NULL; }
    if (pthread_mutex_init(&m->lock, NULL) != 0) { free(m->conds); free(m); return NULL; }
    pthread_condattr_t attr;
    pthread_condattr_init(&attr);
#ifndef __APPLE__
    pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
#endif
    for (int32_t i = 0; i < conds; i++) {
        if (pthread_cond_init(&m->conds[i], &attr) != 0) {
            while (i-- > 0) pthread_cond_destroy(&m->conds[i]);
            pthread_condattr_destroy(&attr);
            pthread_mutex_destroy(&m->lock);
            free(m->conds);
            free(m);
            return NULL;
        }
    }
    pthread_condattr_destroy(&attr);
#endif
    m->count = conds;
    return m;
}

static void scull_monitor_free(void* handle) {
    scull_monitor_impl* m = (scull_monitor_impl*)handle;
    if (m == NULL) return;
#ifndef _WIN32
    for (int32_t i = 0; i < m->count; i++) pthread_cond_destroy(&m->conds[i]);
    pthread_mutex_destroy(&m->lock);
#endif
    free(m->conds);
    free(m);
}

static void scull_monitor_lock(void* handle) {
    scull_monitor_impl* m = (scull_monitor_impl*)handle;
#ifdef _WIN32
    AcquireSRWLockExclusive(&m->lock);
#else
    pthread_mutex_lock(&m->lock);
#endif
}

static void scull_monitor_unlock(void* handle) {
    scull_monitor_impl* m = (scull_monitor_impl*)handle;
#ifdef _WIN32
    ReleaseSRWLockExclusive(&m->lock);
#else
    pthread_mutex_unlock(&m->lock);
#endif
}

/*
 * Waits on condition `cond` with the lock held, for at most `timeout_ns` (negative: no limit).
 * Returns 1 when the time ran out. A wakeup may be spurious either way; callers recheck.
 */
static int32_t scull_monitor_wait(void* handle, int32_t cond, int64_t timeout_ns) {
    scull_monitor_impl* m = (scull_monitor_impl*)handle;
    if (cond < 0 || cond >= m->count) return 0;
    /* A day: callers recompute their deadline after every wakeup, so a longer wait gains nothing. */
    const int64_t longest = 86400LL * 1000000000LL;
    if (timeout_ns > longest) timeout_ns = longest;
#ifdef _WIN32
    DWORD ms = INFINITE;
    if (timeout_ns >= 0) ms = (DWORD)((timeout_ns + 999999) / 1000000);
    if (!SleepConditionVariableSRW(&m->conds[cond], &m->lock, ms, 0)) return GetLastError() == ERROR_TIMEOUT;
    return 0;
#else
    if (timeout_ns < 0) {
        pthread_cond_wait(&m->conds[cond], &m->lock);
        return 0;
    }
#ifdef __APPLE__
    struct timespec rel;
    rel.tv_sec = (time_t)(timeout_ns / 1000000000LL);
    rel.tv_nsec = (long)(timeout_ns % 1000000000LL);
    return pthread_cond_timedwait_relative_np(&m->conds[cond], &m->lock, &rel) == ETIMEDOUT;
#else
    struct timespec at;
    clock_gettime(CLOCK_MONOTONIC, &at);
    int64_t nsec = (int64_t)at.tv_nsec + timeout_ns % 1000000000LL;
    at.tv_sec += (time_t)(timeout_ns / 1000000000LL + nsec / 1000000000LL);
    at.tv_nsec = (long)(nsec % 1000000000LL);
    return pthread_cond_timedwait(&m->conds[cond], &m->lock, &at) == ETIMEDOUT;
#endif
#endif
}

static void scull_monitor_signal(void* handle, int32_t cond) {
    scull_monitor_impl* m = (scull_monitor_impl*)handle;
    if (cond < 0 || cond >= m->count) return;
#ifdef _WIN32
    WakeConditionVariable(&m->conds[cond]);
#else
    pthread_cond_signal(&m->conds[cond]);
#endif
}

static void scull_monitor_broadcast(void* handle, int32_t cond) {
    scull_monitor_impl* m = (scull_monitor_impl*)handle;
    if (cond < 0 || cond >= m->count) return;
#ifdef _WIN32
    WakeAllConditionVariable(&m->conds[cond]);
#else
    pthread_cond_broadcast(&m->conds[cond]);
#endif
}

typedef struct {
    void (*body)(void*);
    void* arg;
    char name[16];
} scull_thread_start_box;

/* Kotlin code may parse a whole batch on these threads; the 512 KiB macOS default is tight for it. */
#define SCULL_THREAD_STACK (2 * 1024 * 1024)

#ifdef _WIN32
static DWORD WINAPI scull_thread_trampoline(LPVOID raw) {
    scull_thread_start_box box = *(scull_thread_start_box*)raw;
    free(raw);
    box.body(box.arg);
    return 0;
}
#else
static void* scull_thread_trampoline(void* raw) {
    scull_thread_start_box box = *(scull_thread_start_box*)raw;
    free(raw);
#ifdef __APPLE__
    pthread_setname_np(box.name);
#else
    pthread_setname_np(pthread_self(), box.name);
#endif
    box.body(box.arg);
    return NULL;
}
#endif

/*
 * Starts a detached thread that runs body(arg); `name` (cut to 15 bytes) names it where the system
 * allows. Returns 0, or the system's error code; body does not run then.
 */
static int32_t scull_thread_start(void (*body)(void*), void* arg, const char* name) {
    scull_thread_start_box* box = (scull_thread_start_box*)calloc(1, sizeof(scull_thread_start_box));
    if (box == NULL) return 12; /* ENOMEM */
    box->body = body;
    box->arg = arg;
    if (name != NULL) strncpy(box->name, name, sizeof(box->name) - 1);
#ifdef _WIN32
    HANDLE thread = CreateThread(NULL, SCULL_THREAD_STACK, scull_thread_trampoline, box, STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
    if (thread == NULL) { int32_t error = (int32_t)GetLastError(); free(box); return error; }
    CloseHandle(thread);
    return 0;
#else
    pthread_attr_t attr;
    int error = pthread_attr_init(&attr);
    if (error != 0) { free(box); return error; }
    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
    pthread_attr_setstacksize(&attr, SCULL_THREAD_STACK);
    pthread_t thread;
    error = pthread_create(&thread, &attr, scull_thread_trampoline, box);
    pthread_attr_destroy(&attr);
    if (error != 0) free(box);
    return error;
#endif
}
